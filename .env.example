# העתק את הקובץ הזה ל-.env ומלא ערכים אמיתיים - .env עצמו לעולם לא עולה ל-git

# Postgres
POSTGRES_USER=garmin_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=garmin_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# יתווספו בשלבים הבאים: SECRET_KEY (JWT), FERNET_KEY (הצפנת טוקן גרמין),
# ANTHROPIC_API_KEY, TELEGRAM_BOT_TOKEN, SMTP settings לאימות מייל
