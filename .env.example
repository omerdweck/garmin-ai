# Copy this file to .env and fill in real values.
# .env is gitignored (along with every .env.* variant) and must never be committed.
#
# Organised as REQUIRED first, then OPTIONAL. A Telegram-bot deployment needs
# only the required block plus ANTHROPIC_API_KEY; everything else has a
# working default or degrades cleanly when left empty.


# =============================================================================
# REQUIRED - the app refuses to start without these
# =============================================================================

# Telegram bot token. Create a bot by sending /newbot to @BotFather.
TELEGRAM_BOT_TOKEN=change_me_your_botfather_token

# Signing key for JWTs. Generate with: openssl rand -hex 32
# Never ship the placeholder: anyone who knows it can forge a valid token.
SECRET_KEY=change_me_generate_a_real_random_secret

# Encrypts stored Garmin session tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Unlike SECRET_KEY, which only signs, this key DECRYPTS - treat it with at
# least as much care. Changing it makes every stored Garmin token unreadable
# and forces everybody to relink.
FERNET_KEY=change_me_generate_a_real_fernet_key


# =============================================================================
# DATABASE AND QUEUE - defaults work as-is under docker compose
# =============================================================================

# Generate a real password with: openssl rand -hex 24
# Postgres only reads this when initialising an EMPTY data directory.
# Changing it against an existing volume also needs
#   ALTER USER <user> WITH PASSWORD '<new>';
# or the app keeps authenticating with the old one and fails.
POSTGRES_USER=garmin_app
POSTGRES_PASSWORD=change_me_generate_a_real_random_password
POSTGRES_DB=garmin_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379


# =============================================================================
# AI COACH - optional, but the bot is much less useful without it
# =============================================================================

# Get one at https://console.anthropic.com
# Left empty, everything except the coach conversation and the daily summary
# still works: linking, syncing, and all the quick-lookup buttons.
ANTHROPIC_API_KEY=

# Purely a cost/quality trade-off - the code is identical for every tier.
# claude-opus-5 and claude-haiku-4-5-20251001 are the tiers either side of
# this one. Prices for each live in app/core/claude_pricing.py.
CLAUDE_MODEL=claude-sonnet-5


# =============================================================================
# ACCESS CONTROL - who may register
# =============================================================================

# New users tap "request access" and the owner approves them by name, so
# there is no shared code to configure. ADMIN_CHAT_ID below is what makes
# that possible: with no approver set, nobody can ever be let in.
#
# Hard ceiling on registered users, applied before a request is even sent.
# Counts existing users; lowering it blocks new signups but never removes
# anybody.
MAX_USERS=10

# The website's own /auth/register. Off because an anonymous HTTP caller
# cannot obtain the owner's approval the way a bot user can - turning it on
# without building that approval step re-opens the only gate this has.
WEBSITE_REGISTRATION_ENABLED=false


# =============================================================================
# USAGE LIMITS - per user, checked before each API call
# =============================================================================

# Two ceilings because they catch different things: a message count stops
# compulsive back-and-forth, a cost cap stops the long tool-heavy
# conversations a message count waves through.
#
# The quick-lookup buttons make no API call and are never limited by either.
# Per-user overrides are set with /admin limit <id> <n>.
DAILY_MESSAGE_LIMIT=30
MONTHLY_COST_LIMIT_USD=3.0


# =============================================================================
# ADMIN - optional
# =============================================================================

# Telegram chat id allowed to run /admin, and the recipient of new-user
# alerts. Unset, the bot runs exactly as it otherwise would, with no admin
# channel. Find yours by messaging @userinfobot on Telegram.
ADMIN_CHAT_ID=


# =============================================================================
# EMAIL - only used by the website, which is paused
# =============================================================================

# OPTIONAL. The only thing that sends mail is the website's registration flow
# (POST /auth/register). The Telegram bot identifies people by chat id and
# sends none at all, so a bot-only deployment should leave SMTP_USERNAME and
# SMTP_APP_PASSWORD empty rather than carry a live mail credential nothing
# there can use.
#
# Configured for Resend's SMTP relay: the username is the literal string
# "resend" and the password is a Resend API key (https://resend.com/api-keys).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# The address recipients see. "onboarding@resend.dev" is Resend's testing
# address - swap it for one on a verified domain before real users get mail.
SMTP_FROM_EMAIL=onboarding@resend.dev

# Base URL used to build the links inside those emails.
APP_BASE_URL=http://localhost:8000

# JWT settings, also website-only: the bot issues no tokens. Defaults are
# fine - listed so every setting the app reads appears in this file.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
