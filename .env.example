# Copy this file to .env and fill in real values - .env itself never gets committed to git

# Postgres - generate a real random password with: openssl rand -base64 32
# Note: Postgres only reads this when it initialises an EMPTY data directory.
# Changing it against an existing volume also needs
#   ALTER USER <user> WITH PASSWORD '<new>';
# or the app will keep authenticating with the old one and fail.
POSTGRES_USER=garmin_app
POSTGRES_PASSWORD=change_me_generate_a_real_random_password
POSTGRES_DB=garmin_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT - generate a real random value with: openssl rand -hex 32
# Never reuse this placeholder as a real secret - anyone who knows it can forge tokens.
SECRET_KEY=change_me_generate_a_real_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP - used to send the email verification link.
# Using Resend's SMTP relay: username is the literal string "resend",
# password is your Resend API key (create one at https://resend.com/api-keys).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_APP_PASSWORD=change_me_your_resend_api_key
# "onboarding@resend.dev" is Resend's official testing address - swap for a verified
# domain address (e.g. noreply@yourdomain.com) once you have real users.
SMTP_FROM_EMAIL=onboarding@resend.dev

# Base URL used to build links sent in emails (points at the API directly for now, no frontend yet)
APP_BASE_URL=http://localhost:8000

# Garmin token encryption - generate a real value with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_generate_a_real_fernet_key

# Telegram bot token - create a bot via @BotFather in Telegram (send it /newbot)
TELEGRAM_BOT_TOKEN=change_me_your_botfather_token

# SMTP is OPTIONAL - only the website registration flow sends email.
# A Telegram-bot-only deployment can leave SMTP_USERNAME and
# SMTP_APP_PASSWORD empty.

# Anthropic API key for the AI coach - get one at https://console.anthropic.com
# OPTIONAL: without it everything except the AI conversation and the daily
# summary still works (linking, syncing, the metrics/activities buttons).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
